# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wrw_db

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Application locale
APP_TIMEZONE=Africa/Harare
CURRENCY_CODE=MWK

# Initial administrator created when the users table is empty
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=

# Initial walk-in customer created when the contacts table is empty
DEFAULT_CUSTOMER_NAME=Walk-in Customer
DEFAULT_CUSTOMER_EMAIL=walkincustomer@example.com
DEFAULT_CUSTOMER_PHONE=
DEFAULT_CUSTOMER_ADDRESS=
